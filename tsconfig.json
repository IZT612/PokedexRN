{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "strict": false,
    "noEmit": true,
    "types": ["react", "react-native"]
  },
  "include": ["App.tsx", "tamagui.config.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "openspec", ".opencode"]
}
